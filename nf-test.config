config {
    // location for all nf-test tests
    testsDir = "."

    // nf-test directory including temporary files for each test
    workDir = System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // location of an optional nextflow.config file specific for executing tests
    configFile = "tests/nextflow.config"

    // CI runner classes can omit tests that need unavailable hardware or exceed
    // their resource envelope. Standard hosted runners skip CPU integration
    // tests; GPU and scientific tests use their dedicated validation runners.
    def skipScientific = System.getenv("SKIP_SCIENTIFIC") == "true"
    def skipGpu = System.getenv("SKIP_GPU") == "true"
    def skipCpuIntegration = System.getenv("SKIP_CPU_INTEGRATION") == "true"
    def baseIgnore = [
        'modules/nf-core/**/tests/*',
        'subworkflows/nf-core/**/tests/*',
    ]
    def scientificTests = ['tests/scientific/**']
    def gpuTests = [
        'modules/local/run_boltz/tests/main.nf.test',
        'modules/local/colabfold_batch/tests/main.nf.test',
        'modules/local/run_alphafold2_pred/tests/main.nf.test',
        'modules/local/run_alphafold3_inference/tests/main.nf.test',
        'modules/local/run_esmfold/tests/main.nf.test'
    ]
    // These real CPU tests use public microDBs, but their container, memory and
    // disk requirements exceed the safe envelope of standard hosted runners.
    def cpuIntegrationTests = [
        'modules/local/mmseqs_colabfoldsearch/tests/main.nf.test',
        'modules/local/run_alphafold2_msa/tests/main.nf.test',
        'modules/local/run_alphafold3_datapipeline/tests/main.nf.test'
    ]
    ignore = baseIgnore +
        (skipScientific ? scientificTests : []) +
        (skipGpu ? gpuTests : []) +
        (skipCpuIntegration ? cpuIntegrationTests : [])

    // run all test with defined profile(s) from the main nextflow.config
    profile = "test"

    // list of filenames or patterns that should be trigger a full test run
    triggers = [
        '.github/actions/nf-test/action.yml',
        '.github/workflows/nf-test.yml',
        'assets/schema_input.json',
        'bin/*',
        'conf/test.config',
        'nextflow.config',
        'nextflow_schema.json',
        'nf-test.config',
        'tests/.nftignore',
        'tests/nextflow.config',
    ]

    // load the necessary plugins
    plugins {
        load "nft-utils@0.0.3"
    }
}
