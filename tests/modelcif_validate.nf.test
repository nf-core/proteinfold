nextflow_process {

    name "Test Process MODELCIF_VALIDATE"
    script "../modules/local/modelcif_validate/main.nf"
    process "MODELCIF_VALIDATE"

    tag "modelcif_validate"

    test("dummy modelcif") {

        when {
            process {
                """
                input[0] = [ [ id: 'test' ], file("$projectDir/assets/DUMMY_MODELCIF.mmcif", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("real modelarchive file (augmented)") {

        when {
            process {
                """
                input[0] = [ [ id: 'real' ], file("$projectDir/assets/ma-atiya1-gk-01-AUGMENTED.cif", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("rejects plain pdbx without ma content") {

        when {
            process {
                """
                input[0] = [ [ id: 'pdbx' ], file("$projectDir/assets/DUMMY_PDBX.mmcif", checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.failed
        }
    }

    test("rejects invalid mmcif") {

        when {
            process {
                """
                input[0] = [ [ id: 'invalid' ], file("$projectDir/assets/DUMMY_INVALID.mmcif", checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.failed
        }
    }

}
