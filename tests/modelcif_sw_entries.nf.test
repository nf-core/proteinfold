nextflow_process {

    name "Test Process MODELCIF_SW_ENTRIES"
    script "../modules/local/assemble_modelcif/main.nf"
    process "ASSEMBLE_MODELCIF"

    tag "modelcif_sw_entries"
    tag "ci_img_misc"
    config "./assemble_modelcif_software.config"

    test("dummy inputs include model software and software groups") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def plddt = new File(outputDir, 'one_rank_plddt.tsv')
                plddt.text = new File(projectDir, 'assets/DUMMY_PLDDT.tsv').readLines()
                    .collect { it.split('\t')[0..1].join('\t') }.join('\n') + '\n'
                new File(outputDir, 'ptm.tsv').text = 'rank_0\t0.381\n'
                new File(outputDir, 'iptm.tsv').text = 'rank_0\t0.617\n'
                """
                input[0] = [
                    [ id: 'sw_entries', model: 'alphafold2', msa_tool: 'jackhmmer', no_template_search: true ],
                    file("$projectDir/assets/DUMMY_MODELCIF.mmcif", checkIfExists: true),
                    file("$projectDir/assets/DUMMY_MSA.tsv",         checkIfExists: true),
                    file("$outputDir/one_rank_plddt.tsv",           checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PAE.tsv",         checkIfExists: true),
                    file("$outputDir/ptm.tsv",                       checkIfExists: true),
                    file("$outputDir/iptm.tsv",                      checkIfExists: true),
                    file("$projectDir/assets/NO_FILE",               checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_DETAILS.yml", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.modelcif.size() == 1
            def modelcifPath = path(process.out.modelcif[0][1])
            def mmcif = modelcifPath.text
            assert mmcif.contains('AlphaFold2')
            assert mmcif.contains('nf-core/proteinfold')
            assert mmcif.contains('jackhmmer')
            assert mmcif.contains('coevolution MSA')
            assert mmcif.contains('modeling')
            assert mmcif.contains('_ma_protocol_step')
            assert path(process.out.versions[0]).getFileName().toString() == 'versions.yml'

        }
    }
}
