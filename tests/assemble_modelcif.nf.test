                }
                input[0] = [
                    [ id: 'test_multi', model: 'alphafold2', msa_tool: 'jackhmmer' ],
                    [
                        file("$projectDir/assets/DUMMY_MMCIF_rank_0.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_1.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_2.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_3.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_4.mmcif", checkIfExists: true)
                    ],
                    file("$projectDir/assets/DUMMY_MSA.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PLDDT.tsv",       checkIfExists: true),
                    file("$outputDir/rank_*_pae.tsv",               checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PTM.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_IPTM.tsv",        checkIfExists: true),
                    file("$projectDir/assets/NO_FILE",               checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_DETAILS.yml", checkIfExists: true)
