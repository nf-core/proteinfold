                assert generator.waitFor() == 0 : generator.err.text
                input[0] = [
                    [ id: 'test_cw', model: 'alphafold2', msa_tool: 'jackhmmer',
                      missing_metrics: ['pae'] ],
                    [
                        file("$projectDir/assets/DUMMY_MMCIF_rank_0.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_1.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_2.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_3.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_4.mmcif", checkIfExists: true)
                    ],
                    file("$projectDir/assets/DUMMY_MSA.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PLDDT.tsv",       checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PAE.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PTM.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_IPTM.tsv",        checkIfExists: true),
                    file("$projectDir/assets/NO_FILE",               checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_DETAILS.yml", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def mmcif = path(process.out.modelcif[0][1]).text
            assertAll(
                { assert !mmcif.contains("_ma_qa_metric_feature") },
                { assert mmcif.contains("LocalPLDDT") }
            )
            assert process.out.versions.size() == 1
        }
    }

    test("template search step is attributed to its own tool") {
        when {
            process {
                """
                def generator = ['python3', "$projectDir/tests/generate_ranked_modelcif.py", "$projectDir/assets/DUMMY_MMCIF_rank_0.mmcif", "$outputDir/ranked"].execute()
                assert generator.waitFor() == 0 : generator.err.text
                input[0] = [
                    [ id: 'test_tpl', model: 'alphafold2', msa_tool: 'jackhmmer',
                      missing_metrics: ['pae'] ],
                    [
                        file("$projectDir/assets/DUMMY_MMCIF_rank_0.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_1.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_2.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_3.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_4.mmcif", checkIfExists: true)
                    ],
                    file("$projectDir/assets/DUMMY_MSA.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PLDDT.tsv",       checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PAE.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PTM.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_IPTM.tsv",        checkIfExists: true),
                    file("$projectDir/assets/NO_FILE",               checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_DETAILS.yml", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def mmcif = path(process.out.modelcif[0][1]).text
            assertAll(
                { assert mmcif.contains("'template search'") },
                { assert mmcif.contains("HHsearch") },
                // the template step must not be lumped in with the modeling software
                { assert mmcif.contains("'coevolution MSA'") }
            )
            assert process.out.versions.size() == 1
        }
    }

}
