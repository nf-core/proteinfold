nextflow_process {

    name "Test metrics are inserted properly by ASSEMBLE_MODELCIF process"
    script "../modules/local/assemble_modelcif/main.nf"
    process "ASSEMBLE_MODELCIF"
    tag "ci_img_misc"

    tag "assemble_modelcif"
    config "./assemble_modelcif_software.config"

    def assertModelcifOutput = { proc, modelcifPath, expectEmbeddedPAE, expectBinaryCIF ->
        assert proc.success
        assert proc.out.modelcif.size() == 1
        assert path(proc.out.versions[0]).getFileName().toString() == 'versions.yml'

        def outName = modelcifPath.getFileName().toString()
        if (expectBinaryCIF) {
            assert outName.endsWith('.bcif')
            assert modelcifPath.bytes.length > 0

            return
        }

        def mmcif = modelcifPath.text
        assertAll(
            { assert outName.endsWith('.mmcif') },
            { assert mmcif.contains("_ma_qa_metric_local"),
                "pLDDT qa_metric table missing from output mmCIF" },

            { assert mmcif.contains("_ma_qa_metric_global"),
                "Global qa_metric table (pTM/ipTM) missing from output mmCIF" },

            { assert mmcif.contains("pTM"),
                "pTM metric type missing from output mmCIF" },

            { assert mmcif.contains("ipTM"),
                "ipTM metric type missing from output mmCIF" },

            {
                if (expectEmbeddedPAE) {
                    assert mmcif.contains("_ma_qa_metric_local_pairwise")
                } else {
                    assert mmcif.contains("_ma_entry_associated_files")
                }
            },

            {
                if (expectEmbeddedPAE) {
                    assert mmcif.contains("PAE")
                } else {
                    assert (mmcif =~ /\S+\.tsv[^\n]*file other other/).find()
                }
            },

            {
                if (expectEmbeddedPAE) {
                    assert !mmcif.contains("_ma_entry_associated_files")
                } else {
                    assert (mmcif =~ /Predicted aligned error|\bPAE\b/).find()
                }
            },

            { assert mmcif.contains("coevolution MSA"),
                "Coevolution MSA protocol step missing from output mmCIF" },

            { assert mmcif.contains("modeling"),
                "Modeling protocol step missing from output mmCIF" }
        )
    }

    test("dummy inputs produce modelcif with associated PAE") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                (0..1).each { rank ->
                    new File(outputDir, "rank_${rank}.mmcif").text = new File(projectDir, 'assets/DUMMY_MODELCIF.mmcif').text
                    new File(outputDir, "rank_${rank}_pae.tsv").text = new File(projectDir, 'assets/DUMMY_PAE.tsv').text
                }
                def plddt = new File(outputDir, 'two_rank_plddt.tsv')
                plddt.text = new File(projectDir, 'assets/DUMMY_PLDDT.tsv').readLines()
                    .collect { it.split('\t')[0..2].join('\t') }.join('\n') + '\n'
                def scores = 'rank_0\t0.5\nrank_1\t0.6\n'
                new File(outputDir, 'ptm.tsv').text = scores
                new File(outputDir, 'iptm.tsv').text = scores
                """
                input[0] = [
                    [id: 'test', model: 'alphafold2', msa_tool: 'jackhmmer'],
                    [file("$outputDir/rank_0.mmcif"), file("$outputDir/rank_1.mmcif")],
                    file("$projectDir/assets/DUMMY_MSA.tsv", checkIfExists: true),
                    file("$outputDir/two_rank_plddt.tsv", checkIfExists: true),
                    [file("$outputDir/rank_0_pae.tsv"), file("$outputDir/rank_1_pae.tsv")],
                    file("$outputDir/ptm.tsv", checkIfExists: true),
                    file("$outputDir/iptm.tsv", checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_VERSIONS.yml", checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_DETAILS.yml", checkIfExists: true)
                ]
                """
            }
        }
        then {
            assert process.success
            def outputFile = path(process.out.modelcif[0][1])
            assert outputFile.text.contains('_ma_qa_metric')
            assert outputFile.text.contains('_ma_protocol_step')
            (0..1).each { rank ->
                def relativePath = "pae/rank_${rank}_pae.tsv"
                assert outputFile.text.contains("model ${relativePath} file other other")
                assert java.nio.file.Files.isRegularFile(outputFile.parent.resolve(relativePath))
            }
            assert process.out.pae[0].size() == 2
            assert path(process.out.versions[0]).getFileName().toString() == 'versions.yml'
            assert outputFile.text.contains('nf-core/proteinfold')
            assert outputFile.text.contains('2.3.2')
        }
    }

    test("dummy inputs produce modelcif with embedded PAE") {
        config "./assemble_modelcif_embed.config"

        when {
            process {
                (0..1).each { rank ->
                    new File(outputDir, "rank_${rank}.mmcif").text = new File(projectDir, 'assets/DUMMY_MODELCIF.mmcif').text
                    new File(outputDir, "rank_${rank}_pae.tsv").text = new File(projectDir, 'assets/DUMMY_PAE.tsv').text
                        .replaceFirst('0\\.2601', rank == 0 ? '0.2601' : '1.2601')
                }
                def plddt = new File(outputDir, 'two_rank_plddt.tsv')
                plddt.text = new File(projectDir, 'assets/DUMMY_PLDDT.tsv').readLines()
                    .collect { it.split('\t')[0..2].join('\t') }.join('\n') + '\n'
                def scores = 'rank_0\t0.5\nrank_1\t0.6\n'
                new File(outputDir, 'ptm.tsv').text = scores
                new File(outputDir, 'iptm.tsv').text = scores
                """
                input[0] = [
                    [id: 'test_embed', model: 'alphafold2', msa_tool: 'jackhmmer'],
                    [file("$outputDir/rank_0.mmcif"), file("$outputDir/rank_1.mmcif")],
                    file("$projectDir/assets/DUMMY_MSA.tsv", checkIfExists: true),
                    file("$outputDir/two_rank_plddt.tsv", checkIfExists: true),
                    [file("$outputDir/rank_0_pae.tsv"), file("$outputDir/rank_1_pae.tsv")],
                    file("$outputDir/ptm.tsv", checkIfExists: true),
                    file("$outputDir/iptm.tsv", checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_VERSIONS.yml", checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_DETAILS.yml", checkIfExists: true)
                ]
                """
            }
        }
        then {
            assert process.success
            def outputFile = path(process.out.modelcif[0][1])
            assert outputFile.text.contains('_ma_qa_metric_local_pairwise')
            assert outputFile.text.contains('1.260')
            assert !outputFile.text.contains('_ma_entry_associated_files')
            assert path(process.out.versions[0]).getFileName().toString() == 'versions.yml'
        }
    }

    test("rejects a mismatch between structures and pLDDT ranks") {
        when {
            process {
                """
                input[0] = [
                    [ id: 'test', model: 'alphafold2', msa_tool: 'jackhmmer' ],
                    file("$projectDir/assets/DUMMY_MODELCIF.mmcif", checkIfExists: true),
                    file("$projectDir/assets/DUMMY_MSA.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PLDDT.tsv",       checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PAE.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PTM.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_IPTM.tsv",        checkIfExists: true),
                    file("$projectDir/assets/NO_FILE",               checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_DETAILS.yml", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.failed
        }
    }

    test("dummy inputs produce binaryCIF") {
        config "./assemble_modelcif_binary.config"

        when {
            process {
                def plddt = new File(outputDir, 'one_rank_plddt.tsv')
                plddt.text = new File(projectDir, 'assets/DUMMY_PLDDT.tsv').readLines()
                    .collect { it.split('\t')[0..1].join('\t') }.join('\n') + '\n'
                new File(outputDir, 'ptm.tsv').text = 'rank_0\t0.5\n'
                new File(outputDir, 'iptm.tsv').text = 'rank_0\t0.6\n'
                """
                input[0] = [
                    [ id: 'test_binary', model: 'alphafold2', msa_tool: 'jackhmmer' ],
                    file("$projectDir/assets/DUMMY_MODELCIF.mmcif", checkIfExists: true),
                    file("$projectDir/assets/DUMMY_MSA.tsv",         checkIfExists: true),
                    file("$outputDir/one_rank_plddt.tsv",           checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PAE.tsv",         checkIfExists: true),
                    file("$outputDir/ptm.tsv",                       checkIfExists: true),
                    file("$outputDir/iptm.tsv",                      checkIfExists: true),
                    file("$projectDir/assets/NO_FILE",               checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_DETAILS.yml", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def modelcifPath = path(process.out.modelcif[0][1])
            assertModelcifOutput(process, modelcifPath, false, true)
        }
    }

    test("dummy inputs include all ranked models by default") {
        when {
            process {
                """
                def generator = ['python3', "$projectDir/tests/generate_ranked_modelcif.py", "$projectDir/assets/DUMMY_MMCIF_rank_0.mmcif", "$outputDir/ranked"].execute()
                assert generator.waitFor() == 0 : generator.err.text
                (0..4).each { rank ->
                    new File("$outputDir/rank_\${rank}_pae.tsv").text =
                        new File("$projectDir/assets/DUMMY_PAE.tsv").text
                }
                input[0] = [
                    [ id: 'test_multi_default', model: 'alphafold2', msa_tool: 'jackhmmer' ],
                    [
                        file("$projectDir/assets/DUMMY_MMCIF_rank_0.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_1.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_2.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_3.mmcif", checkIfExists: true),
                        file("$outputDir/ranked/DUMMY_MMCIF_rank_4.mmcif", checkIfExists: true)
                    ],
                    file("$projectDir/assets/DUMMY_MSA.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PLDDT.tsv",       checkIfExists: true),
                    file("$outputDir/rank_*_pae.tsv",               checkIfExists: true),
                    file("$projectDir/assets/DUMMY_PTM.tsv",         checkIfExists: true),
                    file("$projectDir/assets/DUMMY_IPTM.tsv",        checkIfExists: true),
                    file("$projectDir/assets/NO_FILE",               checkIfExists: true),
                    file("$projectDir/assets/DUMMY_SOFTWARE_DETAILS.yml", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def modelcifPath = path(process.out.modelcif[0][1])
            assertModelcifOutput(process, modelcifPath, false, false)

            def mmcif = modelcifPath.text
            assertAll(
                { assert mmcif.contains("test_multi_default rank_0") },
                { assert mmcif.contains("test_multi_default rank_1") },
                { assert mmcif.contains("test_multi_default rank_2") },
                { assert mmcif.contains("test_multi_default rank_3") },
                { assert mmcif.contains("test_multi_default rank_4") }
            )
            assert process.out.versions.size() == 1
        }
    }

