nextflow_pipeline {

    name "Scientific validation: Boltz"
    script "../../main.nf"
    tag "scientific"
    tag "output_validation"
    tag "structure_validation"
    tag "boltz"
    profile "test_full_boltz,gpu"

    test("Boltz: validate mmCIF structures and metrics") {
        options "--mode boltz --use_gpu"

        when {
            params {
                outdir     = "$outputDir"
                input      = 'https://raw.githubusercontent.com/nf-core/test-datasets/proteinfold/testdata/samplesheet/v2.0/samplesheet_single_fasta.csv'
                boltz_db     = System.getenv("PROTEINFOLD_TEST_DB") ?: 's3://proteinfold-dataset/test-data/mini_dbs'
                colabfold_db = System.getenv("PROTEINFOLD_TEST_DB") ?: 's3://proteinfold-dataset/test-data/mini_dbs'
            }
        }

        then {
            assert workflow.success: "Boltz workflow failed (exit ${workflow.exitStatus})"
            def validator = new File("tests/scientific/validate_outputs.py").absolutePath
            def command = ["python3", validator, "--mode", "boltz", "--display-name", "Boltz",
                           "--extension", ".cif", "--outdir", params.outdir.toString(),
                           "--samplesheet", params.input.toString()]
            def process = command.execute()
            def stdout = new StringBuffer()
            def stderr = new StringBuffer()
            process.consumeProcessOutput(stdout, stderr)
            assert process.waitFor() == 0: "${stdout}\n${stderr}"
            println stdout
            assert file("${params.outdir}/pipeline_info/nf_core_proteinfold_software_mqc_versions.yml").size() > 0
        }
    }
}
