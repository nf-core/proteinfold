nextflow_pipeline {

    name "Test alphafold3 download mode stub"
    script "../main.nf"
    tag "pipeline"
    tag "test_alphafold3_download"
    profile "test_alphafold3_download"
    config "./nextflow.config"

    test("-profile test_alphafold3_download") {
        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def stableName = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stableContent = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assert snapshot(
                workflow.trace.succeeded().size(),
                removeNextflowVersion("$outputDir/pipeline_info/nf_core_proteinfold_software_mqc_versions.yml"),
                stableName,
                stableContent
            ).match()
        }
    }
}
