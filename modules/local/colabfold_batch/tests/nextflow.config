process {
    withName: 'COLABFOLD_BATCH' {
        ext.args = '--msa-mode single_sequence --num-models 1 --num-seeds 1 --model-order 3'
        containerOptions = {
            workflow.containerEngine in ['singularity', 'apptainer'] ?
            '--nv' :
            workflow.containerEngine == 'docker' ?
            '--gpus all' :
            ''
        }
}
