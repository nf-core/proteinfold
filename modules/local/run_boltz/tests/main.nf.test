nextflow_process {

    name "Test Process RUN_BOLTZ"
    script "../main.nf"
    process "RUN_BOLTZ"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "run_boltz"
    tag "gpu"
    profile "test_nostub"
    profile "test_gpu"

    test("runs boltz with minimal inputs") {

        when {
            process {
                """
                def yaml = file(params.pipelines_testdata_base_path + 'testdata/sequences/boltz/mixed_sample.yaml', checkIfExists: true)

                def files = [
                    file(params.pipelines_testdata_base_path + 'testdata/sequences/boltz/mixed_sample_0.csv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'testdata/sequences/boltz/mixed_sample_2.csv', checkIfExists: true)
                ]

                def boltz1 = file('boltz1_conf.ckpt')
                boltz1.text = 'x'

                def ccd = file('ccd.pkl')
                ccd.text = 'x'

                def boltz2Aff = file('boltz2_aff.ckpt')
                boltz2Aff.text = 'x'

                def boltz2Conf = file('s3://proteinfold-dataset/test-data/mini_dbs/params/boltz2_conf.ckpt', checkIfExists: true)

                //TODO: This needs to be reduced to 20 canonical + 4 DNA + 4 RNA + ATP + SEP
                //def mols = file('s3://proteinfold-dataset/test-data/mini_dbs/params/mols', checkIfExists: true)

                //After fixing above TODO this block can be deleted
                def molNames = [
                    'ALA','A','ARG','ASN','ASP','ATP','C','CYS','DA','DC','DG','DT',
                    'GLN','GLU','GLY','G','HIS','ILE','LEU','LYS','MET','PHE','PRO',
                    'SEP','SER','THR','TRP','TYR','UNK','U','VAL'
                ]

                def mols = file('mols')
                mols.mkdirs()

                for (String molCode : molNames) {
                    def p = 's3://proteinfold-dataset/test-data/mini_dbs/params/mols/' + molCode + '.pkl'
                    def src = file(p, checkIfExists: true)
                    def dst = file('mols/' + molCode + '.pkl')
                    dst.bytes = src.bytes
                }
                //

                //meta.id must currently match input basename
                input[0] = [
                    [ id: 'mixed_sample' ],
                    yaml,
                    files
                ]
                input[1] = boltz1
                input[2] = ccd
                input[3] = boltz2Aff
                input[4] = boltz2Conf
                input[5] = mols
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                //{ assert snapshot(process.out).match() } //likely not fully deterministic
            )
        }
    }

}
