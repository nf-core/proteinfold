nextflow_process {

    name "Test Process MMSEQS_COLABFOLDSEARCH_BATCH"
    script "../main.nf"
    process "MMSEQS_COLABFOLDSEARCH_BATCH"
    profile "test"

    tag "modules"
    tag "modules_local"
    tag "mmseqs_colabfoldsearch"

    test("batches ColabFold search inputs and preserves sample IDs") {

        options "-stub"

        when {
            process {
                """
                def dbDir = file('db')
                dbDir.mkdirs()
                file('db/dummy.db').text = 'x'

                def unirefDir = file('uniref30')
                unirefDir.mkdirs()
                file('uniref30/dummy.db').text = 'x'

                def csv1 = file('T1024.csv')
                csv1.text = 'id,sequence\\nT1024,MKTAYIAKQRQISFVKSHFSRQDILD\\n'
                def csv2 = file('T1026.csv')
                csv2.text = 'id,sequence\\nT1026,GIVLDSGDGVTHVVPI\\n'

                input[0] = [
                    [[id: 'T1024'], [id: 'T1026']],
                    [csv1, csv2]
                ]
                input[1] = file('db/*')
                input[2] = file('uniref30/*')
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
