/* Full test profile for ColabFold2 prediction modes. */

params {
    config_profile_name        = 'Full test profile for ColabFold2'
    config_profile_description = 'Full test dataset to check ColabFold2 prediction modes'
    mode                       = 'colabfold2-alphafold3'
    use_gpu                    = true
    input                      = params.pipelines_testdata_base_path + 'proteinfold/testdata/samplesheet/v2.0/samplesheet.csv'
    colabfold_db               = 's3://proteinfold-dataset/test-data/mini_dbs'
}

process {
    executor = 'local'
    withName: 'MMSEQS_COLABFOLDSEARCH' {
        cpus   = 4
        memory = 15.GB
    }
    // The inference processes are reached as COLABFOLD2:<ALIAS> aliases, so match the aliased task name.
    withName: '.*COLABFOLD2:(ALPHAFOLD3|BOLTZ2|OPENFOLD3|OPENBIND0|PROTEINX2|CHAI1|INTELLIFOLD2|OPENDDE|ROSETTAFOLD3|ESMFOLD2)' {
        cpus   = 4
        memory = 60.GB
        time   = '4.h'
    }
}
