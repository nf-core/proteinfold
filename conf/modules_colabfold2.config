/* ColabFold2 preview process configuration. */

process {
    withName: 'COLABFOLD2_INFERENCE' {
        accelerator = { params.use_gpu ? 1 : 0 }
        ext.args = {
            def args = params.use_msa_server && params.msa_server_url ? "--host-url ${params.msa_server_url}" : ''
            // --kernel-backend only takes effect inside colabfold's kernels shim, so an explicit backend also enables --use-fast-kernels.
            if (params.colabfold2_kernel_backend && params.colabfold2_kernel_backend != 'auto') {
                args = "${args} --use-fast-kernels --kernel-backend ${params.colabfold2_kernel_backend}".trim()
            }
            args
        }
        ext.weights_precision = { params.colabfold2_weights_precision }
        publishDir = [
            [
                path: { "${params.outdir}/${public_mode}/${meta.id}" },
                mode: 'copy',
                saveAs: { filename ->
                    if (filename.endsWith('_pae.tsv')) {
                        "paes/$filename"
                    } else {
                        filename
                    }
                },
                pattern: '*.tsv'
            ],
            [
                enabled: params.save_intermediates,
                path: { "${params.outdir}/${public_mode}/${meta.id}" },
                mode: 'copy',
                pattern: 'raw/**'
            ],
            [
                path: { "${params.outdir}/${public_mode}/top_ranked_structures" },
                mode: 'copy',
                saveAs: { "${meta.id}.cif" },
                pattern: '*_colabfold2.cif'
            ]
        ]
    }
}
